{
  "name": "id-generator",
  "title": "ID and password generator",
  "description": "Generate UUIDs, strong random passwords and hex tokens using your browser's secure random source.",
  "category": "developer",
  "inputSchema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "title": "Type",
        "enum": [
          "password",
          "uuid",
          "hex"
        ],
        "default": "password"
      },
      "length": {
        "type": "integer",
        "title": "Length",
        "minimum": 4,
        "maximum": 128,
        "default": 20
      },
      "count": {
        "type": "integer",
        "title": "How many",
        "minimum": 1,
        "maximum": 50,
        "default": 5
      },
      "lowercase": {
        "type": "boolean",
        "default": true
      },
      "uppercase": {
        "type": "boolean",
        "default": true
      },
      "digits": {
        "type": "boolean",
        "default": true
      },
      "symbols": {
        "type": "boolean",
        "default": true
      }
    },
    "required": []
  }
}
