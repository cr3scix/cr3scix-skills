{
  "name": "invoice-maker",
  "title": "Invoice and quote maker",
  "description": "Fill in line items and tax, see a clean document update live, then print it or save it as a PDF.",
  "category": "business",
  "inputSchema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "Invoice",
          "Quote"
        ],
        "default": "Invoice",
        "title": "Document type"
      },
      "number": {
        "type": "string",
        "title": "Number",
        "maxLength": 50,
        "default": "INV-001"
      },
      "date": {
        "type": "string",
        "title": "Date (YYYY-MM-DD)",
        "maxLength": 20
      },
      "from": {
        "type": "string",
        "title": "From",
        "maxLength": 500
      },
      "to": {
        "type": "string",
        "title": "Bill to",
        "maxLength": 500
      },
      "currency": {
        "type": "string",
        "title": "Currency symbol",
        "maxLength": 5,
        "default": "$"
      },
      "taxPercent": {
        "type": "number",
        "title": "Tax (%)",
        "minimum": 0,
        "maximum": 100,
        "default": 0
      },
      "items": {
        "type": "string",
        "title": "Line items, one per line: description | quantity | unit price",
        "maxLength": 10000,
        "x-multiline": true
      },
      "notes": {
        "type": "string",
        "title": "Notes",
        "maxLength": 2000
      }
    },
    "required": [
      "items"
    ]
  }
}
